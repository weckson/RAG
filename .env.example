APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION_DAYS=14
TZ=Australia/Sydney

# IBKR
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
TRADING_MODE=paper

# Risk
MAX_POSITIONS=5
MAX_DAILY_LOSS_USD=200
MAX_ORDER_NOTIONAL_USD=2000
MAX_TOTAL_NOTIONAL_USD=8000
STOP_LOSS_PCT=0.01
TAKE_PROFIT_PCT=0.02

# Storage
DATABASE_URL=sqlite:///./executor.db

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Control API
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8080
CONTROL_API_KEY=
SIGNAL_QUEUE_SIZE=10000

# Safety
KILL_SWITCH=false
KILL_SWITCH_FILE=./KILL
