APP_ENV=dev
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_RETENTION_DAYS=14
TZ=Australia/Sydney

# IBKR
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
TRADING_MODE=paper

# Risk
MAX_POSITIONS=5
MAX_DAILY_LOSS_USD=200
MAX_ORDER_NOTIONAL_USD=2000
MAX_TOTAL_NOTIONAL_USD=8000
STOP_LOSS_PCT=0.01
TAKE_PROFIT_PCT=0.02

# Storage
DATABASE_URL=sqlite:///./executor.db

# Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Control API
CONTROL_HOST=0.0.0.0
CONTROL_PORT=8080
CONTROL_API_KEY=
SIGNAL_QUEUE_SIZE=10000

# Safety
KILL_SWITCH=false
KILL_SWITCH_FILE=./KILL

# AIStock Bridge — Embedded mode (runs inside executor process)
# Set AISTOCK_BRIDGE_ENABLED=true to auto-poll AIStock and execute signals
AISTOCK_BRIDGE_ENABLED=false
AISTOCK_URL=http://127.0.0.1:8000
AISTOCK_SENTIMENT_URL=http://127.0.0.1:8002
AISTOCK_BRIDGE_INTERVAL=20
AISTOCK_DASHBOARD_LIMIT=30
AISTOCK_BRIDGE_DRY_RUN=false
AISTOCK_COOLDOWN_SECONDS=180

# AIStock Bridge — Standalone mode (scripts/aistock_bridge.py)
# These are also used by the standalone script
EXECUTOR_URL=http://127.0.0.1:8080
EXECUTOR_API_KEY=
AISTOCK_MIN_PRIORITY_BUY=55
AISTOCK_MIN_SENTIMENT_BUY=0.2
AISTOCK_MIN_MOMENTUM_BUY=0.05
AISTOCK_MAX_CROWDING_BUY=0.75
AISTOCK_MAX_SENTIMENT_SELL=-0.15
AISTOCK_MAX_MOMENTUM_SELL=-0.10
AISTOCK_MIN_RISK_PENALTY_SELL=12
AISTOCK_BRIDGE_TIMEOUT_SECONDS=10
